# Страница услуги переименована: старый адрес ведёт на новый, чтобы ссылки
# и поисковая выдача не упирались в «страница не найдена».
Redirect 301 /usluga-strahovka.html /usluga-nadzor
Redirect 301 /usluga-strahovka /usluga-nadzor

ErrorDocument 404 /404.html

# HTML не кешируем: правки должны быть видны сразу, без Cmd+Shift+R
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Пока сайт живёт на тестовом адресе — прячем его от поиска, чтобы в выдачу
# не попали дубли. На основном домене buhstart.ru заголовок не выставляется.
<IfModule mod_setenvif.c>
  SetEnvIf Host "(^new\.buhstart\.ru$|regruhosting)" NOINDEX_HOST=1
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_HOST
</IfModule>

# Служебные заготовки страниц: отдаём вместо них настоящие разделы.
Redirect 301 /usluga.html /uslugi
Redirect 301 /usluga /uslugi
Redirect 301 /article.html /blog
Redirect 301 /article /blog

# Адреса без .html: /uslugi вместо /uslugi.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # редактор: короткие адреса вида /panel/texts вместо /panel/app.php?p=texts
  RewriteRule ^panel/[a-z-]+\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^panel/([a-z]+)/?$ /panel/app.php?p=$1 [QSA,L]
  RewriteRule ^panel/?$ /panel/app.php [L]
  RewriteRule ^panel/ - [L]
  # старые адреса с .html — постоянный редирект на чистые, чтобы не было дублей
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  # хвост .html ищем только в самом адресе, до знака вопроса
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  # внутри отдаём тот же файл .html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
